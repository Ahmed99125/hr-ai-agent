# Environment Variables — HR AI Agent on Lua
# Copy this file to .env and fill in your credentials

# ─────────────────────────────────────────
# BambooHR Credentials
# ─────────────────────────────────────────
# Your BambooHR API key (Settings → API Keys)
BAMBOOHR_API_KEY=your_bamboohr_api_key_here
# Your company subdomain (e.g. if your BambooHR URL is acme.bamboohr.com → BAMBOOHR_SUBDOMAIN=acme)
BAMBOOHR_SUBDOMAIN=your_company_subdomain_here

# ─────────────────────────────────────────
# Google Sheets Credentials
# ─────────────────────────────────────────
# The full JSON content of your Google Service Account key file
# (Google Cloud Console → IAM → Service Accounts → Create Key → JSON)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project"}
# The ID of the Google Sheet used for daily performance check-ins
# (found in the sheet URL: https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here
